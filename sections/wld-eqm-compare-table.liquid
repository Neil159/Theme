{%- comment -%}
  Section: WLD — EquilibraMeno — Tableau comparatif ("Pourquoi prendre...")
  A ajouter via Admin Shopify > Boutique en ligne > Themes > Modifier le code > Sections > Ajouter une nouvelle section.
  Puis dans l'editeur visuel : "Ajouter une section" > "WLD Tableau comparatif".
  Clique sur "Seleccionar imagen" pour importer ta vraie photo du bote (format conseille : image verticale/portrait,
  fond transparent de preference, ~500x700px), elle se place au-dessus de la colonne coche, en depassant vers le haut.
{%- endcomment -%}

<div id="wld-eqm-compare-{{ section.id }}" class="eqm-compare">
  <div class="eqm-compare__inner">
    <h2 class="eqm-compare__title">{{ section.settings.title | default: '¿Por qué elegir EquilibraMeno?' }}</h2>

    <div class="eqm-compare__wrap">
      <div class="eqm-compare__card">
        <div class="eqm-compare__podium">
          {%- if section.settings.photo -%}
            {{ section.settings.photo | image_url: width: 300 | image_tag: loading: 'lazy', class: 'eqm-compare__image' }}
          {%- else -%}
            <div class="eqm-compare__placeholder">Foto del<br>bote</div>
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            <div class="eqm-compare__row" {{ block.shopify_attributes }}>
              <span class="eqm-compare__label">{{ block.settings.criteria }}</span>
              <span class="eqm-compare__yes">
                <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5l3.5 3.5L16 5.5" fill="none" stroke="#8a6d1d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="eqm-compare__others">
        <div class="eqm-compare__others-label">{{ section.settings.competitor_label | default: 'OTRAS MARCAS' }}</div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            <div class="eqm-compare__no-row"><span class="eqm-compare__no">✕</span></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
  #wld-eqm-compare-{{ section.id }} {
    background: #fdf1f5;
    padding: 64px 20px 56px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  #wld-eqm-compare-{{ section.id }} * { box-sizing: border-box; }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__inner {
    max-width: 720px;
    margin: 0 auto;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__title {
    font-weight: 700;
    color: #5c1730;
    font-size: 26px;
    text-align: center;
    margin: 0 0 40px 0;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__wrap {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__card {
    position: relative;
    flex: 1 1 auto;
    background: #ffffff;
    border-radius: 14px;
    border: 1px solid #eee1e6;
    overflow: visible;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__podium {
    position: absolute;
    right: 0;
    top: -104px;
    width: 96px;
    height: 130px;
    background: #7a1f3d;
    border-radius: 14px;
    padding: 6px;
    box-shadow: 0 8px 14px rgba(0,0,0,0.18);
    overflow: hidden;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 9px;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f6dfe8;
    font-size: 10px;
    text-align: center;
    line-height: 1.3;
    border-radius: 9px;
    border: 1px dashed #d99cb2;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__row {
    display: flex;
    align-items: center;
    min-height: 64px;
    border-bottom: 1px solid #eee1e6;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__row:last-child {
    border-bottom: none;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__label {
    flex: 1 1 auto;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 14px 18px;
    font-size: 15px;
    font-weight: 600;
    color: #2b1620;
    background: #ffffff;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__row:first-child .eqm-compare__label {
    border-radius: 14px 0 0 0;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__row:last-child .eqm-compare__label {
    border-radius: 0 0 0 14px;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__yes {
    flex-shrink: 0;
    width: 96px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__yes svg {
    width: 20px;
    height: 20px;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__others {
    flex: 0 0 68px;
    display: flex;
    flex-direction: column;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__others-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #2b1620;
    text-align: center;
    margin-bottom: 12px;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__no-row {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid transparent;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__no {
    color: #e0303c;
    font-size: 18px;
    font-weight: 700;
  }
  @media (max-width: 640px) {
    #wld-eqm-compare-{{ section.id }} .eqm-compare__podium { width: 76px; height: 100px; top: -84px; }
    #wld-eqm-compare-{{ section.id }} .eqm-compare__yes { width: 76px; }
    #wld-eqm-compare-{{ section.id }} .eqm-compare__label { font-size: 13px; padding: 12px; }
    #wld-eqm-compare-{{ section.id }} .eqm-compare__others { flex-basis: 48px; }
  }
</style>

{% schema %}
{
  "name": "WLD Tableau comparatif",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "¿Por qué elegir EquilibraMeno?"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Foto del bote (formato vertical recomendado)"
    },
    {
      "type": "text",
      "id": "competitor_label",
      "label": "Etiquette colonne concurrence",
      "default": "OTRAS MARCAS"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "criteria",
          "label": "Critere"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WLD Tableau comparatif",
      "blocks": [
        { "type": "row", "settings": { "criteria": "Sin hormonas de síntesis ni aditivos" } },
        { "type": "row", "settings": { "criteria": "Ingredientes naturales" } },
        { "type": "row", "settings": { "criteria": "Fabricado en laboratorio" } },
        { "type": "row", "settings": { "criteria": "Garantía satisfecha o reembolsada" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product", "index", "page"]
  }
}
{% endschema %}