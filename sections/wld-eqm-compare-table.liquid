{%- comment -%}
  Section: WLD — EquilibraMeno — Tableau comparatif ("Pourquoi prendre...")
  A ajouter via Admin Shopify > Boutique en ligne > Themes > Modifier le code > Sections > Ajouter une nouvelle section.
  Puis dans l'editeur visuel : "Ajouter une section" > "WLD Tableau comparatif".
  Clique sur "Seleccionar imagen" pour importer ta vraie photo du bote (format conseille : image verticale/portrait,
  fond transparent si possible, ~800x1000px), elle se place a droite du tableau en la faisant deborder legerement.
{%- endcomment -%}

<div id="wld-eqm-compare-{{ section.id }}" class="eqm-compare">
  <div class="eqm-compare__inner">
    <h2 class="eqm-compare__title">{{ section.settings.title | default: '¿Por qué elegir EquilibraMeno?' }}</h2>

    <div class="eqm-compare__wrap">
      <div class="eqm-compare__table">
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            <div class="eqm-compare__row" {{ block.shopify_attributes }}>
              <span class="eqm-compare__label">{{ block.settings.criteria }}</span>
              <span class="eqm-compare__cell eqm-compare__cell--yes">
                <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M4 10.5l3.5 3.5L16 5.5" fill="none" stroke="#8a6d1d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="eqm-compare__cell eqm-compare__cell--no">✕</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.photo -%}
        <div class="eqm-compare__media">
          {{ section.settings.photo | image_url: width: 500 | image_tag: loading: 'lazy', class: 'eqm-compare__image' }}
        </div>
      {%- else -%}
        <div class="eqm-compare__media eqm-compare__media--placeholder">
          <span>Foto del bote<br>~800x1000px</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #wld-eqm-compare-{{ section.id }} {
    background: #fdf1f5;
    padding: 56px 20px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  #wld-eqm-compare-{{ section.id }} * { box-sizing: border-box; }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__inner {
    max-width: 720px;
    margin: 0 auto;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__title {
    font-weight: 700;
    color: #5c1730;
    font-size: 26px;
    text-align: center;
    margin: 0 0 32px 0;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__table {
    flex: 1 1 auto;
    background: #ffffff;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #eee1e6;
    padding-right: 90px;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__row {
    display: flex;
    align-items: center;
    gap: 0;
    border-bottom: 1px solid #eee1e6;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__row:last-child {
    border-bottom: none;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__label {
    flex: 1 1 auto;
    padding: 18px 20px;
    font-size: 15px;
    font-weight: 600;
    color: #2b1620;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__cell {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__cell--yes {
    width: 64px;
    height: 100%;
    background: #f4f0d6;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__cell--yes svg {
    width: 20px;
    height: 20px;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__cell--no {
    width: 44px;
    color: #d64550;
    font-size: 16px;
    font-weight: 700;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__media {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 140px;
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__image {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 10px 16px rgba(0,0,0,0.15));
  }
  #wld-eqm-compare-{{ section.id }} .eqm-compare__media--placeholder {
    height: 220px;
    border: 2px dashed #c9b8c0;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 12px;
    color: #7a6a70;
    background: #fff;
  }
  @media (max-width: 640px) {
    #wld-eqm-compare-{{ section.id }} .eqm-compare__wrap {
      flex-direction: column;
    }
    #wld-eqm-compare-{{ section.id }} .eqm-compare__table {
      padding-right: 0;
      width: 100%;
    }
    #wld-eqm-compare-{{ section.id }} .eqm-compare__media {
      position: static;
      transform: none;
      width: 120px;
      margin: 16px auto 0;
    }
  }
</style>

{% schema %}
{
  "name": "WLD Tableau comparatif",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "¿Por qué elegir EquilibraMeno?"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Foto del bote (formato vertical recomendado)"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "criteria",
          "label": "Critere"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WLD Tableau comparatif",
      "blocks": [
        { "type": "row", "settings": { "criteria": "Ingredientes naturales" } },
        { "type": "row", "settings": { "criteria": "Fabricado en laboratorio" } },
        { "type": "row", "settings": { "criteria": "Garantía satisfecha o reembolsada" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product", "index", "page"]
  }
}
{% endschema %}