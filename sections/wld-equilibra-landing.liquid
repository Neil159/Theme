<script>
(function () {
  function wldInitEquilibra(root) {
    if (!root || root.__wldInit) return;
    root.__wldInit = true;

    var mainImages = root.querySelectorAll('[data-wld-main-image]');
    var thumbs = root.querySelectorAll('[data-wld-thumb]');
    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var idx = thumb.getAttribute('data-index');
        thumbs.forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
        mainImages.forEach(function (img) {
          img.classList.toggle('is-active', img.getAttribute('data-index') === idx);
        });
      });
    });

    var variantInput = root.querySelector('[id$="-variant-input"]');
    var bundleRadios = root.querySelectorAll('.wld-e-bundle-card input[type="radio"]');
    var bundleCards = root.querySelectorAll('.wld-e-bundle-card');
    var heroPills = root.querySelectorAll('.wld-e-hero__bundle-pill');

    function selectBundle(index) {
      bundleCards.forEach(function (card, i) {
        var isMatch = i === index;
        card.classList.toggle('is-selected', isMatch);
        var radio = card.querySelector('input[type="radio"]');
        if (radio) {
          radio.checked = isMatch;
          if (isMatch && variantInput && radio.getAttribute('data-variant-id')) {
            variantInput.value = radio.getAttribute('data-variant-id');
          }
        }
      });
      heroPills.forEach(function (pill, i) {
        pill.classList.toggle('is-active', i === index);
      });
    }

    bundleRadios.forEach(function (radio, i) {
      radio.addEventListener('change', function () { selectBundle(i); });
    });

    heroPills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        var idx = parseInt(pill.getAttribute('data-wld-bundle-index'), 10);
        selectBundle(idx);
        var buybox = root.querySelector('.wld-e-buybox');
        if (buybox) buybox.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    var preselected = root.querySelector('.wld-e-bundle-card.is-selected') || bundleCards[0];
    if (preselected) {
      var allCards = Array.prototype.slice.call(bundleCards);
      selectBundle(allCards.indexOf(preselected));
    }
  }

  function wldInitAll() {
    document.querySelectorAll('.wld-equilibra').forEach(function (root) {
      wldInitEquilibra(root);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', wldInitAll);
  } else {
    wldInitAll();
  }

  document.addEventListener('shopify:section:load', function (event) {
    var root = event.target.querySelector ? event.target.querySelector('.wld-equilibra') : null;
    if (root) {
      root.__wldInit = false;
      wldInitEquilibra(root);
    }
  });
})();
</script>

