{%- comment -%}
  Section: WLD — EquilibraMeno — Banniere hero page Confort intimo
  A ajouter via Admin Shopify > Boutique en ligne > Themes > Modifier le code > Sections > Ajouter une nouvelle section.
  Deux champs image : "Foto desktop" (obligatoire) et "Foto mobile" (optionnel). Si tu ne mets pas de foto mobile,
  la foto desktop sera utilisee et recadree automatiquement sur mobile.
{%- endcomment -%}

<div id="wld-eqm-vhero-{{ section.id }}" class="eqm-vhero">
  <div class="eqm-vhero__text">
    <h1 class="eqm-vhero__title">
      {{ section.settings.title_line1 | default: 'Probióticos vaginales' }}
      <em class="eqm-vhero__accent">{{ section.settings.title_accent | default: 'para un olor' }}</em>
      {{ section.settings.title_line2 | default: 'y un pH saludables' }}
    </h1>
    <a href="{{ section.settings.button_link | default: '#eqm-buy' }}" class="eqm-vhero__button">{{ section.settings.button_label | default: 'Lo pruebo' }}</a>
  </div>

  <div class="eqm-vhero__media">
    {%- if section.settings.photo_mobile -%}
      {{ section.settings.photo_mobile | image_url: width: 900 | image_tag: loading: 'lazy', class: 'eqm-vhero__image eqm-vhero__image--mobile' }}
    {%- endif -%}
    {%- if section.settings.photo_desktop -%}
      {{ section.settings.photo_desktop | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'eqm-vhero__image eqm-vhero__image--desktop' }}
    {%- else -%}
      <div class="eqm-vhero__placeholder">Foto desktop<br>~1400x1000px</div>
    {%- endif -%}
  </div>
</div>

<style>
  #wld-eqm-vhero-{{ section.id }} {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    min-height: 380px;
    background: linear-gradient(90deg, #f7d9c8 0%, #f3c3bb 100%);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    overflow: hidden;
  }
  #wld-eqm-vhero-{{ section.id }} * { box-sizing: border-box; }
  #wld-eqm-vhero-{{ section.id }} .eqm-vhero__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 6vw;
  }
  #wld-eqm-vhero-{{ section.id }} .eqm-vhero__title {
    font-size: 34px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    margin: 0 0 28px 0;
  }
  #wld-eqm-vhero-{{ section.id }} .eqm-vhero__accent {
    font-style: italic;
    font-weight: 400;
  }
  #wld-eqm-vhero-{{ section.id }} .eqm-vhero__button {
    display: inline-block;
    width: fit-content;
    background: #ffffff;
    color: #b5302f;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 14px 32px;
    border-radius: 30px;
  }
  #wld-eqm-vhero-{{ section.id }} .eqm-vhero__media {
    position: relative;
    min-height: 320px;
  }
  #wld-eqm-vhero-{{ section.id }} .eqm-vhero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #wld-eqm-vhero-{{ section.id }} .eqm-vhero__image--mobile {
    display: none;
  }
  #wld-eqm-vhero-{{ section.id }} .eqm-vhero__placeholder {
    width: 100%;
    height: 100%;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #ffffff;
    font-size: 13px;
    border: 2px dashed rgba(255,255,255,0.6);
  }
  @media (max-width: 749px) {
    #wld-eqm-vhero-{{ section.id }} {
      grid-template-columns: 1fr;
    }
    #wld-eqm-vhero-{{ section.id }} .eqm-vhero__text {
      padding: 36px 24px 28px;
      text-align: center;
      align-items: center;
    }
    #wld-eqm-vhero-{{ section.id }} .eqm-vhero__title {
      font-size: 26px;
    }
    #wld-eqm-vhero-{{ section.id }} .eqm-vhero__media {
      min-height: 260px;
      order: -1;
    }
    #wld-eqm-vhero-{{ section.id }} .eqm-vhero__image--desktop {
      display: none;
    }
    #wld-eqm-vhero-{{ section.id }} .eqm-vhero__image--mobile {
      display: block;
    }
    {%- unless section.settings.photo_mobile -%}
    #wld-eqm-vhero-{{ section.id }} .eqm-vhero__image--desktop {
      display: block;
    }
    {%- endunless -%}
  }
</style>

{% schema %}
{
  "name": "WLD Hero Confort intimo",
  "settings": [
    {
      "type": "text",
      "id": "title_line1",
      "label": "Titre - avant le mot en italique",
      "default": "Probióticos vaginales"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Titre - mot en italique",
      "default": "para un olor"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Titre - fin",
      "default": "y un pH saludables"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Lo pruebo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "image_picker",
      "id": "photo_desktop",
      "label": "Foto desktop (obligatoire, ~1400x1000px)"
    },
    {
      "type": "image_picker",
      "id": "photo_mobile",
      "label": "Foto mobile (optionnelle - sinon reutilise la foto desktop)"
    }
  ],
  "presets": [
    { "name": "WLD Hero Confort intimo" }
  ],
  "enabled_on": {
    "templates": ["product", "index", "page"]
  }
}
{% endschema %}